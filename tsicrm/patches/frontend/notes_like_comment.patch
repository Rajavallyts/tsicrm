+// Comments (flat — no nested replies)
+// ------------------------------------
+// Reuses the generic Comment doctype pointed at this note via
+// reference_doctype/reference_name, and the same crm.api.comment.add_comment
+// endpoint the Lead/Deal comment box posts through.
+const showComments = ref(false)
+const loadingComments = ref(false)
+const comments = ref([])
+
+async function toggleComments() {
+  showComments.value = !showComments.value
+  if (showComments.value && !comments.value.length) {
+    await loadComments()
+  }
+}
+
+async function loadComments() {
+  loadingComments.value = true
+  try {
+    // frappe.client.get_list enforces the Comment doctype's own permissions,
+    // which on this site don't grant regular roles read access to Comment
+    // directly (confirmed: PermissionError for non-Administrator users, even
+    // though they can read the note itself just fine). tsicrm's
+    // get_note_comments gates on the note's reference document instead --
+    // the same boundary the rest of this feature already uses -- so it
+    // works for whoever can already see the note.
+    comments.value = await call('tsicrm.crm_overrides.activities.get_note_comments', {
+      note: props.note.name,
+    })
+  } catch (e) {
+    toast.error(__('Failed to load comments'))
+  } finally {
+    loadingComments.value = false
+  }
+}
