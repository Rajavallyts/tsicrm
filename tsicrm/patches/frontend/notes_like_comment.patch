+// Like / unlike
+// -------------
+// `_liked_by` is the standard JSON-array-of-user-emails field every doctype
+// carries. Toggling it goes through tsicrm's toggle_note_like rather than
+// frappe.desk.like.toggle_like directly: that generic API gates on
+// frappe.has_permission("FCRM Note", "read", doc=note) -- FCRM Note's own
+// DocPerm plus Frappe's default user-permission check on reference_docname
+// -- which is a different, independently-evaluated boundary from the one
+// that actually governs note visibility (permission on the parent Lead/
+// Deal via crm's org-hierarchy hook). Non-Administrator users could already
+// see and comment on a note yet still get a PermissionError liking it.
+// toggle_note_like gates on the parent document instead, the same boundary
+// get_note_comments already uses.
+const isLiked = computed(() => {
+  if (!props.note._liked_by) return false
+  try {
+    return JSON.parse(props.note._liked_by).includes(user)
+  } catch {
+    return false
+  }
+})
+
+const likeCount = computed(() => {
+  if (!props.note._liked_by) return 0
+  try {
+    return JSON.parse(props.note._liked_by).length
+  } catch {
+    return 0
+  }
+})
+
+const togglingLike = ref(false)
+
+async function toggleLike() {
+  if (togglingLike.value) return
+  togglingLike.value = true
+  try {
+    await call('tsicrm.crm_overrides.activities.toggle_note_like', {
+      note: props.note.name,
+      add: isLiked.value ? 'No' : 'Yes',
+    })
+    notes.value?.reload()
+  } catch (e) {
+    toast.error(__('Failed to update like'))
+  } finally {
+    togglingLike.value = false
+  }
+}
